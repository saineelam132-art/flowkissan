 "assumptions_E": {
  "glycol.cp_kJ_kgK": "E – 30-35 % propylene glycol near 0 C: about 3.7 kJ/kg.K (design brief; check the glycol supplier's data sheet).",
  "glycol.freeze_C": "E – 30-35 % propylene glycol freezes at about -13 C (design brief; check the data sheet).",
  "glycol.hx_approach_K": "E – brazed-plate heat exchanger approach 3 K: R290 evaporating temperature = glycol supply - 3 K (design brief).",
  "glycol.supply_room_C": "E – glycol supply about 0 C when only the air cooler is fed (design brief).",
  "glycol.supply_wax_C": "E – glycol supply about -2 C when the wax is being frozen (design brief).",
  "glycol.design_dT_K": "E – glycol warms 3 K at full 1.5 kW load; this sets the fixed pump flow (our choice, typical 3-5 K).",
  "glycol.pump_W": "E – small DC circulation pump 40 W, runs only with the chiller (design brief). All of it is counted as heat into the glycol (conservative).",
  "glycol.pipe_UA_W_K": "E – about 6 m of insulated outdoor glycol pipe plus plate exchanger, tank and valves: 3 W/K to the outside air (our estimate: 19 mm nitrile foam on 22 mm pipe is about 0.25 W/m.K; doubled for fittings).",
  "glycol.air_cooler_G_kW_K": "E – glycol air cooler with EC fan: 900 m3/h of air (0.32 kW/K), effectiveness about 0.78 -> 0.25 kW per K between room air and mean glycol temperature (our estimate; check the chosen unit).",
  "glycol.air_cooler_air_side_frac": "E – 75 % of the air cooler's heat resistance is on the air side, so the wet fin surface is warmer than the glycol: T_surface = T_room - 0.75 x (T_room - T_glycol_mean). This decides how much water the coil takes out of the air (our estimate, typical finned coil).",
  "glycol.wax_coil_R_m2K_W": "E – contact resistance of the coils in the wax panels, same value as the old twin (0.01 m2K/W).",
  "glycol.loop_volume_L": "E – about 15 L of glycol in pipes, coils and tank (our estimate). Used only in the reality check (re-cooling the loop at every start).",
  "pcm.melt_range_C": "E – C14-rich paraffin blend with a little C13 melts over 3.0-4.0 C (design brief; needs a DSC test of the real blend).",
  "pcm.latent_kJ_kg": "E – 190 kJ/kg (old design value, lower end of the data sheet) x 0.93 because 7 wt% is graphite = 176.7 kJ/kg.",
  "pcm.graphite_wt_frac": "E – 7 wt% expanded graphite (design brief).",
  "pcm.k_multiplier": "E – thermal conductivity x5 against pure paraffin (0.2 -> 1.0 W/m.K) in the panel model (design brief; literature for 5-10 wt% expanded graphite gives x3 to x10).",
  "pcm.price_INR_kg": "E – Rs 1,000/kg, our quotation; range Rs 600-1,600/kg.",
  "pcm.charge_stop_C": "E – wax charging stops when the solid wax is 1 K below the lower melting point (same rule as the old twin).",
  "product.pulldown_hours": "E – flowers in ventilated crates lose 7/8 of their extra warmth in 4 h (same rule as the old twin; flowers are light, so this is likely conservative).",
  "door": "E – 6 door openings a day (05:00, 05:10, 09:00, 13:00, 13:10, 17:00), 20 s each, strip curtain 85 % effective (design brief + old twin).",
  "live_run.load_hour": "E – unsold surplus is loaded at 13:00 at that hour's outside air temperature and taken out at 05:00 (design brief).",
  "live_run.sun_factor": "E – sunlight x 0.88 (old twin: Open-Meteo corrected to the NASA POWER level).",
  "controller.protect_above_C": "E – grid help when the room stays above 6.0 C (top of the normal band) for 15 min, off again below 5.0 C (our rule). results/live/night_limit.json shows what 5.5 and 6.5 C would give.",
  "humidity.liner_transpiration_factor": "E – perforated polyethylene crate liners cut the water loss of the flowers to about 25 % of the unlined value (literature for perforated film liners: 50-90 % less weight loss).",
  "humidity.tray": "E – open water tray 0.5 m2 on the floor, natural convection 4 W/m2K (our estimate).",
  "humidity.fogger": "E – ultrasonic fogger 0.30 L/h, 30 W, switched on below 90 % RH and off at 95 % (design brief + typical small unit). Needs clean (RO) water.",
